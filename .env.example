# Bot token from @BotFather. Turn on "Bot-to-bot Communication Mode" for the bot there.
BOT_TOKEN=
# Telegram user ids that may do everything, comma separated.
ADMIN_IDS=
# From https://my.telegram.org, for the verifier's user account.
TG_API_ID=
TG_API_HASH=

# Optional, shown with their defaults.
# OPEN=true            # false: only /allow-ed ids and admins get answers
# MAX_PENDING=5000
# MAX_PER_TAG=100
# ITEMS_PER_MIN=30
# QUERIES_PER_MIN=30
# PAGE_SIZE=30
# VERIFY_PER_MIN=20
